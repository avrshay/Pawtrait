DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pawtrait
# Set to "true" for managed MySQL hosts that require SSL (PlanetScale, Railway, etc.).
DB_SSL=false

# Default password assigned when an admin/manager creates a new user.
DEFAULT_NEW_USER_PASSWORD=Pass123

# Groq API
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Public URL of the deployed frontend — used for CORS and Socket.IO (defaults to localhost:5173 if unset).
FRONTEND_URL=http://localhost:5173

# Public URL of this backend itself — used to build links to uploaded/generated images (defaults to localhost:3000 if unset).
BACKEND_URL=http://localhost:3000

# Port to listen on (Render and similar hosts set this automatically; defaults to 3000 if unset).
PORT=3000

